[Desktop Entry]
Name=TermHub
Comment=Remote terminal and file management workspace
Exec=/usr/bin/transterm %U
TryExec=/usr/bin/transterm
Icon=transterm
Terminal=false
Type=Application
Categories=Utility;Network;
Keywords=SSH;SFTP;FTP;Terminal;
# Tauri's stable Linux application ID is `com.transterm.desktop`. GNOME uses
# the desktop-file ID (filename without its final `.desktop`) to group a
# Wayland window with its launcher, so this companion entry must retain the
# second suffix. The visible transterm.desktop entry remains the app launcher.
NoDisplay=true
StartupWMClass=transterm
