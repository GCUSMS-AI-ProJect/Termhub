{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermHub",
  "version": "2.3.1-beta.11",
  "identifier": "com.transterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5188",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run prepare:rea && npm run build:renderer",
    "beforeBundleCommand": "node ./src-tauri/scripts/build-dock-tile-plugin.mjs"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "TermHub",
        "width": 1280,
        "height": 820,
        "minWidth": 1150,
        "minHeight": 790,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5188 ws://localhost:5188; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "resources": {
      "resources/rea/": "rea/"
    },
    "active": true,
    "targets": "all",
    "icon": ["icons/app/macos/icon.icns", "icons/app/windows/classic.ico", "icons/app/shared/classic-512.png"],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "files": {
        "PlugIns/TranstermDockTile.docktileplugin": "./target/dock-tile-plugin/TranstermDockTile.docktileplugin"
      }
    }
  }
}
