{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "TermHub",
        "width": 1280,
        "height": 820,
        "minWidth": 1150,
        "minHeight": 790,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/gcusms/fileterm/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "TermHub"
}
